{
  "name": "sigrid-vscode",
  "displayName": "Sigrid",
  "description": "View and manage Sigrid findings in VS Code.",
  "icon": "media/sigrid-logo-128.png",
  "version": "0.0.9",
  "publisher": "softwareimprovementgroup",
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "sigrid",
    "code-quality",
    "quality",
    "code-analysis",
    "findings",
    "maintainability",
    "security",
    "refactoring",
    "open-source-health",
    "code-inspection",
    "technical-debt",
    "software-improvement",
    "jira"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "sigridFindingsPanel",
          "title": "Sigrid",
          "icon": "media/sigrid-outlined.svg"
        }
      ]
    },
    "views": {
      "sigridFindingsPanel": [
        {
          "id": "sigridView",
          "name": "Sigrid",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "sigrid-vscode.showFindings",
        "title": "Sigrid: Show Findings"
      }
    ],
    "configuration": [
      {
        "id": "sigrid",
        "title": "Sigrid",
        "properties": {
          "sigrid-vscode.apiKey": {
            "type": "string",
            "default": "",
            "description": "Your Sigrid API Key.",
            "order": 0
          },
          "sigrid-vscode.portfolioName": {
            "type": "string",
            "default": "",
            "description": "Enter the exact portfolio name (case-sensitive) as defined in Sigrid.",
            "order": 1
          },
          "sigrid-vscode.customer": {
            "type": "string",
            "default": "",
            "description": "Deprecated: use portfolioName instead.",
            "deprecationMessage": "Deprecated: use 'Portfolio Name' (sigrid-vscode.portfolioName) instead. Your value will be migrated automatically on next extension activation.",
            "order": 100
          },
          "sigrid-vscode.system": {
            "type": "string",
            "default": "",
            "description": "Enter the exact system name (case-sensitive) as defined in Sigrid.",
            "order": 2
          },
          "sigrid-vscode.subsystem": {
            "type": "string",
            "default": "",
            "description": "Enter the exact subsystem name (case-sensitive) as defined in Sigrid. Only required if you want to view findings for a specific subsystem. Leave empty to view findings for the entire system.",
            "order": 3
          },
          "sigrid-vscode.sigridUrl": {
            "type": "string",
            "default": "https://sigrid-says.com",
            "description": "The URL of your Sigrid instance. Only change this if you are using a self-hosted version of Sigrid.",
            "order": 4
          }
        }
      },
      {
        "id": "sigrid-jira",
        "title": "Jira",
        "properties": {
          "sigrid-vscode.jiraBaseUrl": {
            "type": "string",
            "default": "",
            "description": "Your JIRA base URL (e.g. https://jira.example.com).",
            "order": 0
          },
          "sigrid-vscode.jiraUser": {
            "type": "string",
            "default": "",
            "description": "Your JIRA username or email address.",
            "order": 1
          },
          "sigrid-vscode.jiraToken": {
            "type": "string",
            "default": "",
            "description": "Your JIRA personal access token.",
            "order": 2
          },
          "sigrid-vscode.jiraSpaceKey": {
            "type": "string",
            "default": "",
            "description": "The JIRA space key to create issues in (e.g. AAP).",
            "order": 3
          }
        }
      }
    ]
  },
  "scripts": {
    "install:all": "npm install && cd sigrid-ext-app && npm install",
    "start:webview": "cd sigrid-ext-app && npm run start",
    "build:webview": "cd sigrid-ext-app && npm run build:prod && rm -rf ../dist/sigrid-ext-app/* && cp -r dist/* ../dist/ && cd ..",
    "vscode:prepublish": "npm run build:webview && npm run check-types && npm run lint && node esbuild.js --production",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "vsce package",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "esbuild": "^0.27.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Software-Improvement-Group/sigrid-vscode-extension.git"
  }
}
